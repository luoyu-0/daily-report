# OpenAI-compatible 接口；不填写 API key 时自动使用规则摘要。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# 可选配置
APP_PORT=4173
REVIEW_PORT=5173
DATA_DIR=./data
OUTPUT_DIR=./output

# 可选：仅对本项目的 Node.js 进程启用代理。
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=127.0.0.1,localhost

