# OpenAI-compatible 接口；不填写 API key 时自动使用规则摘要。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_CONCURRENCY=2
LLM_EVIDENCE_MAX_CHARS=1600

# 可选：提高 GitHub REST API 限额。不要提交真实 Token。
GITHUB_TOKEN=
GITHUB_CANDIDATE_LIMIT=15
GITHUB_CACHE_HOURS=12

# 可选配置
APP_PORT=4173
REVIEW_PORT=5173
DATA_DIR=./data
OUTPUT_DIR=./output

# 可选：仅对本项目的 Node.js 进程启用代理。
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# 如本地代理与 GitHub 或 OpenAI 的 TLS 握手不兼容，可按域名直连。
# NO_PROXY=127.0.0.1,localhost,openai.com,.openai.com,github.com,.github.com

